NODE_ENV=development
PORT=3000

# Database (PostgreSQL) - get your own credentials
DATABASE_URL=postgresql://username:password@localhost:5432/zenkai_db?sslmode=disable
DATABASE_POOL_MAX=10

# Optional: Redis for caching
REDIS_URL=redis://localhost:6379

# Provider Settings
PROVIDER_HTTP_TIMEOUT_MS=5000

# AniList API (public, no key needed)
ANILIST_ENDPOINT=https://graphql.anilist.co

# Jikan API (public, no key needed)
JIKAN_ENDPOINT=https://api.jikan.moe/v4

# Streaming providers (optional - only enable with proper licensing)
# CONSUMET_URL=http://localhost:3000
# MIRURO_URL=
# ANIPUB_URL=

# Demo streams (for testing without licensed content)
ENABLE_DEMO_STREAMS=true

# Playback proxy (advanced - leave disabled unless needed)
ENABLE_PLAYBACK_PROXY=false
PLAYBACK_PROXY_ALLOWLIST=
