NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://zenkai:zenkai_password@localhost:5432/zenkai_db?sslmode=disable
DATABASE_POOL_MAX=10

# Provider Settings
PROVIDER_HTTP_TIMEOUT_MS=5000

# Upstream metadata APIs (optional overrides)
ANILIST_ENDPOINT=https://graphql.anilist.co
JIKAN_ENDPOINT=https://api.jikan.moe/v4

# Playback source providers.
#
# The self-hosted library and the bundled demo HLS streams need no
# configuration. The providers below are OFF unless you set their URL: they
# read from third-party sites that generally host unlicensed copies, so
# enabling one is a licensing decision for whoever operates this service.
#
# Consumet: your own self-hosted instance.
# CONSUMET_URL=http://localhost:3000
#
# Scrape providers: only set if you have the right to use them.
# MIRURO_URL=
# ANIPUB_URL=
