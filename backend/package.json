{
  "name": "zenkai-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Zenkai Anime & Manga Decoupled Provider Backend API",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node ../scripts/free-port.js 4000",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prestart": "node ../scripts/free-port.js 4000",
    "start": "node dist/index.js",
    "db:generate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
